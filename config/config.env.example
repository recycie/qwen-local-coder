# Copy to ~/.config/qwen-local-coder/config.env and uncomment what you need.

# Reuse an existing models directory instead of downloading again
# (files are still sha256-verified before use).
# QLC_MODELS_DIR=~/models

# Expose on the LAN: requires an API key file (one key per line, chmod 600).
# QLC_HOST=0.0.0.0
# QLC_API_KEY_FILE=~/.config/qwen-local-coder/api-keys

# Longer context costs VRAM; re-run `qlc tune` after changing it.
# QLC_CTX=49152
# QLC_CPU_FFN=62

# Extra raw llama-server flags (whitespace separated, no quoting)
# QLC_EXTRA_ARGS=--reasoning-budget 4096
