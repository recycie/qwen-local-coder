# qwen-local-coder defaults. Do not edit; override in (lowest to highest precedence):
#   1. config/profiles/<QLC_PROFILE>.env
#   2. ${XDG_CONFIG_HOME:-~/.config}/qwen-local-coder/config.env   (or the file named by QLC_CONFIG)
#   3. QLC_* environment variables
# Files are parsed as plain KEY=VALUE lines (never executed). "~" and "${HOME}" expand to $HOME.

# Hardware profile from config/profiles/ (tested: rtx5060-8gb-quality, rtx5060-8gb-fast)
QLC_PROFILE=rtx5060-8gb-quality

# Where artifacts live
QLC_DATA_DIR=${HOME}/.local/share/qwen-local-coder
QLC_MODELS_DIR=
QLC_STATE_DIR=${HOME}/.local/state/qwen-local-coder

# Pinned artifacts (ids from locks/artifacts.lock)
QLC_LLAMA_VARIANT=cuda-13.4
QLC_MODEL=IQ2_XS

# Network. Binding to anything other than loopback requires an API key file
# unless QLC_ALLOW_INSECURE=1.
QLC_HOST=127.0.0.1
QLC_PORT=8089
QLC_ALIAS=qwen3.8-27b
QLC_API_KEY_FILE=
QLC_ALLOW_INSECURE=0
QLC_TIMEOUT_S=3600

# Placement / performance
QLC_CTX=32768
QLC_CPU_FFN=60
QLC_THREADS=6
QLC_BATCH=2048
QLC_UBATCH=512
QLC_KV_TYPE=q8_0
QLC_FLASH_ATTN=on
# 1 = CUDA managed memory (needed to fit a ~6GB model on an 8GB desktop GPU)
QLC_UNIFIED_MEMORY=0
QLC_SPEC_TYPE=draft-mtp
QLC_SPEC_N_MAX=3
QLC_CACHE_RAM_MIB=8192

# Sampling (Qwen recommended values for coding)
QLC_TEMP=0.6
QLC_TOP_P=0.95
QLC_TOP_K=20
QLC_MIN_P=0

# Operations
QLC_START_TIMEOUT_S=300
QLC_STOP_TIMEOUT_S=30
QLC_MIN_FREE_VRAM_MIB=6000
QLC_EXTRA_ARGS=
