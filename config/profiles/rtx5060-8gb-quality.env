# Quality profile. Tested 2026-10-13: RTX 5060 8GB (~6.6GB free under a Wayland desktop),
# i7-12700F, 32GB RAM (~17GB/s measured bandwidth), llama.cpp b11576.
# Result: ~5 tok/s generation, ~80 tok/s prompt processing, MTP acceptance ~90%.
# QLC_CPU_FFN=60 is the smallest value verified stable at 32K ctx (see docs/TUNING.md).
QLC_MODEL=IQ2_XS
QLC_CTX=32768
QLC_CPU_FFN=60
QLC_THREADS=6
QLC_UBATCH=512
QLC_KV_TYPE=q8_0
QLC_SPEC_TYPE=draft-mtp
QLC_SPEC_N_MAX=3
QLC_MIN_FREE_VRAM_MIB=6000
